# ── Copiar como .env y rellenar ──────────────────────────────────────────────

# JWT — genera un secreto fuerte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UN_TOKEN_SEGURO_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480       # 8 horas
REFRESH_TOKEN_EXPIRE_DAYS=30          # 30 días — sin re-login un mes

# Base de datos Turso (o ruta local SQLite para desarrollo)
# Turso: libsql://TU_DB.turso.io
# Local: sqlite:///./incidencias.db
DATABASE_URL=sqlite:///./incidencias.db
TURSO_AUTH_TOKEN=                     # dejar vacío en local, rellenar en producción

# CORS — orígenes permitidos separados por coma
# En producción: https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email daemon (opcional, para el cron job)
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
